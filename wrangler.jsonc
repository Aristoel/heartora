{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heartora",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "heartora-db",
      "database_id": "7238ec7c-7faf-4722-abe1-ea47535f7e86"
    }
  ]
}
